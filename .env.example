# Required in production. Generate a long random value for SECRET_KEY.
SECRET_KEY=

# Optional locally; use a persistent Render Postgres database in production.
DATABASE_URL=

# Identifies this app to OpenStreetMap's Nominatim geocoding service.
NOMINATIM_USER_AGENT=CommuteSafe/1.0 (+https://commutesafe.onrender.com; contact: anushkasangle0811@gmail.com)

# Optional SendGrid email alerts. Use a verified sender email address.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Optional SMS alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
