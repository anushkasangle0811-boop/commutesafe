# Required in production. Generate a long random value for SECRET_KEY.
SECRET_KEY=

# Optional locally; use a persistent Render Postgres database in production.
DATABASE_URL=

# Optional SendGrid email alerts. Use a verified sender email address.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Optional SMS alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
