# Required in production. Generate a long random value for SECRET_KEY.
SECRET_KEY=

# Optional locally; use a persistent Render Postgres database in production.
DATABASE_URL=

# Optional email alerts (the current service sends through Gmail SMTP).
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# Optional SMS alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
